# Backend environment variables (set by orchestrator)
# If POSTGRES_URL is provided, it will be used directly. Otherwise the individual vars are used.
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
POSTGRES_HOST=localhost
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5000

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000
