# Environment variables for Notes Backend (FastAPI)
# These variables are read at runtime by src/api/main.py:get_database_url()

# Preferred: full PostgreSQL connection URL
# Example format: postgresql://<user>:<password>@<host>:<port>/<db>
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# Or construct from individual parts (used only if POSTGRES_URL is not set)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5000

# Frontend origin allowed by CORS (optional; defaults to http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000
